doctype html
html
    head
        title Asset Management System

        meta(charset="UTF-8")
        meta(name="viewport" content="width=device-width, initial-scale=1")

        link(rel="stylesheet", href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css")
        link(rel="stylesheet", href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css")

        style.
            body{
                margin:0;
                background:#f4f6f9;
                font-family:Arial, Helvetica, sans-serif;
            }

            .sidebar{
                position:fixed;
                left:0;
                top:0;
                width:260px;
                height:100vh;
                background:#212529;
                overflow-y:auto;
            }

            .logo{
                color:white;
                text-align:center;
                padding:25px;
                font-size:28px;
                border-bottom:1px solid #444;
            }

            .sidebar a{
                display:block;
                color:white;
                text-decoration:none;
                padding:18px 25px;
                font-size:18px;
            }

            .sidebar a:hover{
                background:#0d6efd;
            }

            .content{
                margin-left:260px;
                padding:40px;
            }

    body

        .sidebar

            .logo AMS

            a(href="/")
                i.fa-solid.fa-gauge.me-2
                | Dashboard

            a(href="/employees")
                i.fa-solid.fa-users.me-2
                | Employee Master

            a(href="/categories")
                i.fa-solid.fa-tags.me-2
                | Category Master

            a(href="/assets")
                i.fa-solid.fa-laptop.me-2
                | Asset Master

            a(href="/stock")
                i.fa-solid.fa-cubes.me-2
                | Stock View

            a(href="/issues")
                i.fa-solid.fa-arrow-right-to-bracket.me-2
                | Issue Asset

            a(href="/returns")
                i.fa-solid.fa-arrow-right-from-bracket.me-2
                | Return Asset

            a(href="/scrap")
                i.fa-solid.fa-trash.me-2
                | Scrap Asset

            a(href="/history")
                i.fa-solid.fa-clock-rotate-left.me-2
                | Asset History

        .content
            block content

        script(src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js")