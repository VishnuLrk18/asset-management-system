extends ../layout

block content

    h1.mb-4 Returned Assets

    a.btn.btn-primary.mb-3(href="/returns/add")
        | + Return Asset

    table.table.table-bordered

        thead.table-dark

            tr
                th Employee
                th Asset
                th Return Date
                th Remarks

        tbody

            each item in returns

                tr

                    td= item.AssetIssue.Employee.name

                    td= item.AssetIssue.Asset.assetName

                    td= item.returnDate

                    td= item.remarks