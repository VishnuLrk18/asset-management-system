extends ../layout

block content

    h2.mb-4 Add Asset

    form(action="/assets/add" method="POST")

        .row

            .col-md-6.mb-3
                label Asset Code
                input.form-control(
                    type="text"
                    name="assetCode"
                    required
                )

            .col-md-6.mb-3
                label Asset Name
                input.form-control(
                    type="text"
                    name="assetName"
                    required
                )

            .col-md-6.mb-3
                label Category

                select.form-select(name="categoryId" required)

                    option(value="")
                        | Select Category

                    each category in categories

                        option(value=category.id)
                            = category.categoryName

            .col-md-6.mb-3
                label Serial Number
                input.form-control(
                    type="text"
                    name="serialNumber"
                )

            .col-md-6.mb-3
                label Make
                input.form-control(
                    type="text"
                    name="make"
                )

            .col-md-6.mb-3
                label Model
                input.form-control(
                    type="text"
                    name="model"
                )

            .col-md-6.mb-3
                label Purchase Date
                input.form-control(
                    type="date"
                    name="purchaseDate"
                )

            .col-md-6.mb-3
                label Purchase Cost
                input.form-control(
                    type="number"
                    name="purchaseCost"
                )

        button.btn.btn-success(type="submit")
            | Save Asset