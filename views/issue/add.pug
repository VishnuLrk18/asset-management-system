extends ../layout

block content

    h1.mb-4 Issue Asset

    form(action="/issues/add" method="POST")

        .mb-3

            label.form-label Employee

            select.form-select(name="employeeId")

                each employee in employees

                    option(value=employee.id)= employee.name

        .mb-3

            label.form-label Asset

            select.form-select(name="assetId")

                each asset in assets

                    option(value=asset.id)= asset.assetName

        .mb-3

            label.form-label Issue Date

            input.form-control(type="date" name="issueDate")

        .mb-3

            label.form-label Expected Return

            input.form-control(type="date" name="expectedReturnDate")

        .mb-3

            label.form-label Remarks

            textarea.form-control(name="remarks")

        button.btn.btn-success(type="submit")
            | Issue Asset